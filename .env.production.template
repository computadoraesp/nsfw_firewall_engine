# NSFW Firewall Engine - Production Environment Variables Template
# Copy this file to .env and fill in your actual values

# Required: API Keys (at least one key is required for production)
# Generate using: python scripts/generate_secrets.py
NSFW_API_KEYS={"classifier_svc": "<REPLACE_WITH_GENERATED_HASH>", "monitoring_svc": "<REPLACE_WITH_GENERATED_HASH>", "admin_svc": "<REPLACE_WITH_GENERATED_HASH>"}

# Optional: Key-to-tenant mapping
NSFW_KEY_TENANTS={"classifier_svc": "acme-corp", "monitoring_svc": "platform", "admin_svc": "platform"}

# Required: Hash salt and pepper for API key hashing
# Generate using: python scripts/generate_secrets.py
NSFW_HASH_SALT="<REPLACE_WITH_GENERATED_SALT>"
NSFW_HASH_PEPPER="<REPLACE_WITH_GENERATED_PEPPER>"

# Required: Metrics token for /metrics endpoint
# Generate using: python scripts/generate_secrets.py
NSFW_METRICS_TOKEN="<REPLACE_WITH_GENERATED_TOKEN>"

# Required: Audit log file path
NSFW_AUDIT_FILE=/var/log/nsfw-firewall/audit.jsonl

# Optional: Redis URL for decision cache
# NSFW_REDIS_URL=redis://localhost:6379/0

# Required: TLS certificates (if using TLS)
# NSFW_TLS_CERT_FILE=/certs/server.crt
# NSFW_TLS_KEY_FILE=/certs/server.key
# NSFW_TLS_CA_FILE=/certs/ca.crt
# NSFW_TLS_CLIENT_CA_FILE=/certs/client-ca.crt

# Security settings
NSFW_ENGINE_CONFIG=/app/config/engine_config.yaml
